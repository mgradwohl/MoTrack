<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- UTF-8 process code page (Windows 10 1903+): GetACP() is 65001, so narrow CRT calls, the "A"
           APIs and narrow std::filesystem::path conversions take UTF-8. The test binaries have no
           manifest, so MoTrack code must not depend on it (CONTRIBUTING.md, "Text encoding and locale").
           Qt sets per-monitor DPI awareness itself; this manifest does not declare it. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
