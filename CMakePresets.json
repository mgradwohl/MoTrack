    { "name": "win-pgo-baseline", "configurePreset": "win-pgo-baseline", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "win-dev",
      "steps": [
        { "type": "configure", "name": "win-debug" },
        { "type": "build", "name": "win-debug" },
        { "type": "test", "name": "win-debug" }
      ]
    },
    {
      "name": "asan-ubsan-cycle",
      "steps": [
        { "type": "configure", "name": "asan-ubsan" },
        { "type": "build", "name": "asan-ubsan" },
        { "type": "test", "name": "asan-ubsan" }
      ]
    },
    {
      "name": "ubsan-cycle",
      "steps": [
        { "type": "configure", "name": "ubsan" },
        { "type": "build", "name": "ubsan" },
        { "type": "test", "name": "ubsan" }
      ]
    },
    {
      "name": "tsan-cycle",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "test", "name": "coverage" }
