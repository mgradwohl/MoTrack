{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "posix",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "optimized",
      "inherits": "release",
      "cacheVariables": {
        "MOTRACK_THIN_LTO": "ON"
      }
    },
    {
      "name": "stage",
      "inherits": "release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "MOTRACK_STAGE_DESKTOP": "ON"
      }
    },
    {
      "name": "release-compatible",
      "inherits": "release",
      "cacheVariables": {
        "MOTRACK_COMPATIBLE": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "dev",
      "cacheVariables": {
        "MOTRACK_COVERAGE": "ON"
      }
    },
    {
      "name": "unity",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": "relwithdebinfo",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer",
        "MOTRACK_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "benchmark",
      "inherits": "release",
      "cacheVariables": {
        "MOTRACK_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "pgo-generate",
      "inherits": "benchmark",
      "cacheVariables": {
        "MOTRACK_PGO_GENERATE": "ON"
      }
    },
    {
      "name": "pgo-use",
      "inherits": "benchmark",
      "cacheVariables": {
        "MOTRACK_PGO_PROFILE": "${sourceDir}/profiles/motrack.profdata"
      }
    },
    {
      "name": "pgo-baseline",
      "inherits": "benchmark"
    },
    {
      "name": "asan-ubsan",
      "inherits": "posix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "ubsan",
      "inherits": "posix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "tsan",
      "inherits": "posix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -fsanitize=thread -fno-omit-frame-pointer"
      }
    },
    {
      "name": "msan",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -stdlib=libc++ -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fPIE",
        "CMAKE_EXE_LINKER_FLAGS": "-pie"
      }
    },
    {
      "name": "win-debug",
      "inherits": [
        "windows",
        "debug"
      ]
    },
    {
      "name": "win-relwithdebinfo",
      "inherits": [
        "windows",
        "relwithdebinfo"
      ]
    },
    {
      "name": "win-release",
      "inherits": [
        "windows",
        "release"
      ]
    },
    {
      "name": "win-optimized",
      "inherits": [
        "windows",
        "optimized"
      ]
    },
    {
      "name": "win-release-compatible",
      "inherits": [
        "windows",
        "release-compatible"
      ]
    },
    {
      "name": "win-coverage",
      "inherits": [
        "windows",
        "coverage"
      ]
    },
    {
      "name": "win-unity",
      "inherits": [
        "windows",
        "unity"
      ]
    },
    {
      "name": "win-profile",
      "inherits": [
        "windows",
        "profile"
      ]
    },
    {
      "name": "win-benchmark",
      "inherits": [
        "windows",
        "benchmark"
      ]
    },
    {
      "name": "win-pgo-generate",
      "inherits": [
        "windows",
        "pgo-generate"
      ]
    },
    {
      "name": "win-pgo-use",
      "inherits": [
        "windows",
        "pgo-use"
      ]
    },
    {
      "name": "win-pgo-baseline",
      "inherits": [
        "windows",
        "pgo-baseline"
      ]
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "release", "configurePreset": "release" },
    { "name": "stage", "configurePreset": "stage" },
    { "name": "optimized", "configurePreset": "optimized" },
    { "name": "release-compatible", "configurePreset": "release-compatible" },
    { "name": "coverage", "configurePreset": "coverage" },
