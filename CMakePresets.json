    { "name": "win-release", "configurePreset": "win-release", "output": { "outputOnFailure": true } },
    { "name": "win-optimized", "configurePreset": "win-optimized", "output": { "outputOnFailure": true } },
    { "name": "win-release-compatible", "configurePreset": "win-release-compatible", "output": { "outputOnFailure": true } },
    { "name": "win-coverage", "configurePreset": "win-coverage", "output": { "outputOnFailure": true } },
