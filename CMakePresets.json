    { "name": "pgo-baseline", "configurePreset": "pgo-baseline" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "msan", "configurePreset": "msan" },
    { "name": "win-debug", "configurePreset": "win-debug" },
    { "name": "win-relwithdebinfo", "configurePreset": "win-relwithdebinfo" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-optimized", "configurePreset": "win-optimized" },
    { "name": "win-release-compatible", "configurePreset": "win-release-compatible" },
    { "name": "win-coverage", "configurePreset": "win-coverage" },
    { "name": "win-unity", "configurePreset": "win-unity" },
    { "name": "win-profile", "configurePreset": "win-profile" },
    { "name": "win-benchmark", "configurePreset": "win-benchmark" },
    { "name": "win-pgo-generate", "configurePreset": "win-pgo-generate" },
    { "name": "win-pgo-use", "configurePreset": "win-pgo-use" },
    { "name": "win-pgo-baseline", "configurePreset": "win-pgo-baseline" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "optimized", "configurePreset": "optimized", "output": { "outputOnFailure": true } },
    { "name": "release-compatible", "configurePreset": "release-compatible", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    { "name": "unity", "configurePreset": "unity", "output": { "outputOnFailure": true } },
    { "name": "profile", "configurePreset": "profile", "output": { "outputOnFailure": true } },
