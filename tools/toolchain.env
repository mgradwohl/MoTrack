# MoTrack's pinned developer toolchain: the one place these versions are written down.
# tools/setup-dev.*, tools/check-prereqs.*, tools/dev-env.*, tools/dev_sdk.py and
# .github/workflows/ci.yml read it. Only KEY=value lines (no spaces or quotes); CI appends them to
# GITHUB_ENV and Bash sources them. CONTRIBUTING.md#pinned-toolchain explains each choice.

# One LLVM major everywhere: the Windows and Linux compilers, and clang-format and clang-tidy on all
# three platforms (macOS compiles with Apple Clang). Windows installs exactly this release from LLVM's
# signed MSI; Linux follows apt.llvm.org's llvm-toolchain-<codename>-23 and macOS Homebrew's llvm@23.
MOTRACK_LLVM_MAJOR=23
MOTRACK_LLVM_VERSION=23.1.5
# SHA-256 of LLVM-23.1.5-win64.msi as published with the llvmorg-23.1.5 GitHub release.
MOTRACK_LLVM_WIN64_SHA256=288ab326377157a9e02e6fb9724914cc2b55963882d493a405f31dc66e837c12
# apt.llvm.org's signing key (https://apt.llvm.org/llvm-snapshot.gpg.key), checked before it is trusted.
MOTRACK_LLVM_APT_KEY_FINGERPRINT=6084F3CF814B57C1CF12EFD515CF4D18AF4F7421

# Linux: Clang builds against GCC 14's libstdc++ (Qt's Linux binaries use libstdc++, never libc++).
MOTRACK_GCC_MAJOR=14
# macOS: Apple Clang and the system libc++, as Qt's macOS binaries use; Xcode 16.3+ (macos-15 CI: 16.4).
MOTRACK_APPLE_CLANG_MIN=17

MOTRACK_QT_VERSION=6.8.3
MOTRACK_QT_MIN=6.8

# Windows installs these exact versions through WinGet. The floors are what the build needs
# (CMake: cmake_minimum_required and presets v6; Ninja: Ubuntu 24.04's; ccache: optional).
MOTRACK_CMAKE_VERSION=4.4.4
MOTRACK_CMAKE_MIN=3.25
MOTRACK_NINJA_VERSION=1.13.2
MOTRACK_NINJA_MIN=1.11
MOTRACK_CCACHE_VERSION=4.14.3
MOTRACK_CCACHE_MIN=4.9
# CI's actions/setup-python series and the floor everywhere; Windows installs this 3.12 release.
MOTRACK_PYTHON_VERSION=3.12
MOTRACK_PYTHON_WINDOWS_VERSION=3.12.10
MOTRACK_GIT_MIN=2.30

# Windows: Visual Studio 2026 Build Tools (the windows-2025 image's MSVC STL 14.52 needs Clang 22+)
# and the standalone Windows SDK 26100 the image builds with. 10.0.26100.7463 is the newest build
# whose installer also runs on Windows 10 and Windows 11 before 24H2.
MOTRACK_VISUAL_STUDIO_PACKAGE=Microsoft.VisualStudio.BuildTools
MOTRACK_MSVC_TOOLSET_MIN=14.50
MOTRACK_WINDOWS_SDK_VERSION=10.0.26100.7463
