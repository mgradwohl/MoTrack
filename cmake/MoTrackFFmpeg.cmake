set(MOTRACK_FFMPEG_ROOT "$ENV{MOTRACK_FFMPEG_ROOT}" CACHE PATH "FFmpeg SDK installed by MoTrack's setup scripts")
if(NOT MOTRACK_FFMPEG_ROOT)
    set(MOTRACK_FFMPEG_ROOT "$ENV{MOTRACK_FFMPEG_ROOT}")
endif()

add_library(motrack_ffmpeg INTERFACE)
if(MOTRACK_FFMPEG_ROOT)
    list(PREPEND CMAKE_MODULE_PATH "${MOTRACK_FFMPEG_ROOT}/share/ffmpeg")
    cmake_policy(PUSH)
    if(POLICY CMP0174)
        cmake_policy(SET CMP0174 NEW)
    endif()
    find_package(FFMPEG REQUIRED MODULE)
    cmake_policy(POP)
    if(NOT FFMPEG_libavformat_LIBRARY OR NOT FFMPEG_libavcodec_LIBRARY OR NOT FFMPEG_libavutil_LIBRARY OR NOT FFMPEG_libswscale_LIBRARY)
        message(FATAL_ERROR "The FFmpeg SDK needs avformat, avcodec, avutil, and swscale.")
    endif()
    target_include_directories(motrack_ffmpeg SYSTEM INTERFACE ${FFMPEG_INCLUDE_DIRS})
    target_link_directories(motrack_ffmpeg INTERFACE ${FFMPEG_LIBRARY_DIRS})
    target_link_libraries(motrack_ffmpeg INTERFACE ${FFMPEG_LIBRARIES})
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(FFmpeg REQUIRED IMPORTED_TARGET libavformat>=60 libavcodec>=60 libavutil>=58 libswscale>=7)
    target_link_libraries(motrack_ffmpeg INTERFACE PkgConfig::FFmpeg)
endif()
